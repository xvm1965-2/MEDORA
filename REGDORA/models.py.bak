    )

    # B_07.01.0110: Sono stati individuati fornitori terzi alternativi di servizi TIC?
    ALTERNATIVE_VENDOR_CHOICES = [
        ('1', "sì"),
        ('2', "no"),
        ('7', "valutazione non effettuata"),
    ]
    alternative_vendor = models.CharField(
        max_length=1,
        choices=ALTERNATIVE_VENDOR_CHOICES,
        verbose_name="Fornitori terzi alternativi di servizi TIC individuati? (B_07.01.0110)",
        help_text="Utilizzare una delle opzioni indicate per l'individuazione di fornitori terzi alternativi di servizi TIC.",
    )

    # B_07.01.0120: Individuazione di fornitori terzi alternativi di servizi TIC
    alternative_vendor_details = models.TextField(
        verbose_name="Dettagli sui fornitori terzi alternativi di servizi TIC (B_07.01.0120)",
        help_text="Informazioni supplementari sui fornitori terzi alternativi di servizi TIC.",
        blank=True,
        null=True,
    )

    def save(self, *args, **kwargs):
        # Try to set the vendor_code from the related third_party_vendor_code
        try:
            third_party_vendor_signing = self.contract_reference_number.thirdpartysigningset.all().first()
            if third_party_vendor_signing:
                # Set the vendor_code from the related third_party_vendor_code field
                self.vendor_code = third_party_vendor_signing.third_party_vendor_code
        except AttributeError:
            # Handle case where no related instance is found
            pass
        
        # Now that vendor_code is set (or potentially remains None), set the code_type
        if self.vendor_code:
            self.code_type = self.vendor_code.code_type  # Set the code_type from the related vendor code
        
        super(ServiceEvaluation_B7_01, self).save(*args, **kwargs)


    def __str__(self):
        return f"{self.contract_reference_number.contract_reference_number} - {self.vendor_code.vendor_code}"

    class Meta:
        db_table = "ServiceEvaluation-B7_01"
        verbose_name = "Service Evaluation (B7_01)"
        verbose_name_plural = "Service Evaluations (B7_01)"
